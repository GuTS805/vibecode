# ---- required ----
# Google AI Studio key — free, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# ---- optional ----
# Port for the Express server. Render sets this automatically.
PORT=3000

# Model used for discovery, judging, and writing. Must support Google Search grounding.
# GEMINI_MODEL=gemini-2.5-flash

# Comma-separated fallbacks, tried in order when the primary returns 429 (quota) or
# 404 (model not available to this project). The free tier caps requests PER MODEL PER
# DAY (20/day/model on the key this was built against), so a longer chain is the main way
# to buy daily headroom — each model brings its own allowance. Dead entries are dropped
# from the chain automatically at runtime.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3-flash-preview,gemini-3.6-flash,gemini-2.0-flash-lite

# How long the autonomous loop runs after an agent is initialized (hours).
# AUTONOMY_HOURS=48

# Gap between autonomous cycles; each gap is randomized within this range. This is a
# FLOOR, not the final answer — see CYCLE_DAILY_CALL_BUDGET below.
# CYCLE_MIN_HOURS=2
# CYCLE_MAX_HOURS=3

# Daily API-call budget shared across every active agent. The cadence above stretches
# automatically so the whole roster fits inside it: one agent stays at 2-3h, six agents
# spread to roughly 8-9h apart. Without this, adding agents silently exhausts the daily
# quota partway through day one and everything stops publishing.
# Set to 0 to disable and use the fixed interval regardless.
# CYCLE_DAILY_CALL_BUDGET=100
# CYCLE_CALLS_ESTIMATE=6
#
# NOTE: Google Search grounding is metered separately from text generation and is shared
# project-wide, and each cycle makes exactly one grounded call. If grounding is what runs
# out first (symptom: code GROUNDING_QUOTA while plain generation still works), pace on it
# directly instead — set CYCLE_CALLS_ESTIMATE=1 and make the budget below the number of
# grounded calls per day your project actually gets:
# CYCLE_CALLS_ESTIMATE=1
# CYCLE_DAILY_CALL_BUDGET=20

# Gap between the first cycles of agents initialized back to back, so seeding a whole
# roster does not fire every priming cycle at once and rate-limit itself.
# PRIME_STAGGER_MINUTES=3

# Minimum spacing between individual API calls, to stay under the per-minute cap.
# MIN_CALL_GAP_MS=4000
# RATE_LIMIT_BACKOFF_SECONDS=35

# How soon to retry after a transient failure (per-minute rate limit, network) instead
# of forfeiting the slot and waiting for the next full cycle.
# CYCLE_RETRY_MINUTES=10

# Editorial knobs.
# SCORE_THRESHOLD=70          # overall score a candidate must clear to publish
# MAX_POSTS_PER_CYCLE=2       # approved candidates beyond this are deferred, not rejected
# MEMORY_POSTS=20             # published posts carried into every prompt

# Where store.db lives. Point this at a mounted disk to persist history across deploys.
# DATA_DIR=/var/data
