# ---- required ----
# Google AI Studio key (free, no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# ---- optional ----
# Port for the Express server. Render sets this automatically.
PORT=3000

# Model used for judging and writing. Defaults to gemini-2.0-flash.
# GEMINI_MODEL=gemini-2.0-flash

# Comma-separated fallbacks, tried in order when the primary returns 429/404.
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.0-flash-lite

# How long the autonomous loop runs after an agent is initialized (hours).
# AUTONOMY_HOURS=48

# Gap between autonomous cycles; each gap is randomized within this range.
# CYCLE_MIN_HOURS=2
# CYCLE_MAX_HOURS=3

# Where store.db lives. Point this at a mounted disk on Render to persist history.
# DATA_DIR=/var/data
