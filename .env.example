# ---- required ----
# Google AI Studio key — free, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# ---- optional ----
# Port for the Express server. Render sets this automatically.
PORT=3000

# Model used for discovery, judging, and writing. Must support Google Search grounding.
# GEMINI_MODEL=gemini-2.5-flash

# Comma-separated fallbacks, tried in order when the primary returns 429 (quota) or
# 404 (model not available to this project). The free tier caps requests PER MODEL PER
# DAY (20/day/model on the key this was built against), so a longer chain is the main way
# to buy daily headroom — each model brings its own allowance. Dead entries are dropped
# from the chain automatically at runtime.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3-flash-preview,gemini-3.6-flash,gemini-2.0-flash-lite

# How long the autonomous loop runs after an agent is initialized (hours).
# AUTONOMY_HOURS=48

# Gap between autonomous cycles; each gap is randomized within this range. This is a
# FLOOR, not the final answer — see CYCLE_DAILY_CALL_BUDGET below.
# CYCLE_MIN_HOURS=2
# CYCLE_MAX_HOURS=3

# Daily API-call budget shared across every active agent. The cadence above stretches
# automatically so the whole roster fits inside it: one agent stays at 2-3h, six agents
# spread to roughly 8-9h apart. Without this, adding agents silently exhausts the daily
# quota partway through day one and everything stops publishing.
# Set to 0 to disable and use the fixed interval regardless.
# CYCLE_DAILY_CALL_BUDGET=100
# CYCLE_CALLS_ESTIMATE=6
#
# NOTE: Google Search grounding is metered separately from text generation and is shared
# project-wide, and each cycle makes exactly one grounded call. If grounding is what runs
# out first (symptom: code GROUNDING_QUOTA while plain generation still works), pace on it
# directly instead — set CYCLE_CALLS_ESTIMATE=1 and make the budget below the number of
# grounded calls per day your project actually gets:
# CYCLE_CALLS_ESTIMATE=1
# CYCLE_DAILY_CALL_BUDGET=20

# Gap between the first cycles of agents initialized back to back, so seeding a whole
# roster does not fire every priming cycle at once and rate-limit itself.
# PRIME_STAGGER_MINUTES=3

# Minimum spacing between individual API calls, to stay under the per-minute cap.
# MIN_CALL_GAP_MS=4000
# RATE_LIMIT_BACKOFF_SECONDS=35

# How soon to retry after a transient failure (per-minute rate limit, network) instead
# of forfeiting the slot and waiting for the next full cycle.
# CYCLE_RETRY_MINUTES=10

# Editorial knobs.
# SCORE_THRESHOLD=58          # overall score a candidate must clear to publish on merit
# STANDARD_FLOOR=30           # no single standard may score below this
# MAX_POSTS_PER_CYCLE=2       # approved candidates beyond this are deferred, not rejected
# MEMORY_POSTS=20             # published posts carried into every prompt
#
# When nothing clears SCORE_THRESHOLD, the best candidate scoring at least RESCUE_SCORE
# (and at least 40 on beat fit) is published anyway, so a quiet news day produces a quieter
# post rather than an empty feed. Its real score is still stored, so a thin post is never
# presented as a strong one.
# RESCUE_SCORE=42
#
# Set ALLOW_EMPTY_CYCLE=true to turn the rescue off and restore strict behaviour, where a
# cycle in which nothing clears the threshold publishes nothing at all.
# ALLOW_EMPTY_CYCLE=false

# Where store.db lives. Point this at a mounted disk to persist history across deploys.
# DATA_DIR=/var/data

# ---------------------------- Pollinations.ai ------------------------------
# Post artwork comes from Pollinations and needs NO key, NO signup, and has no quota.
# Set POST_IMAGES=false to publish text-only.
# POST_IMAGES=true
# POLLINATIONS_IMAGE_MODEL=sana        # the only model on the anonymous tier
# POLLINATIONS_IMAGE_HEIGHT=640        # generated taller than the 16:9 card, so the card
#                                      # can crop off the bottom strip where this model
#                                      # renders garbled pseudo-text despite nologo=true

# Pollinations TEXT is a different story: it is metered in "pollen" and the anonymous
# balance is 0.0000, so any prompt with real content returns 402. Verified by bisection —
# a 6-character prompt succeeds, 200 characters already fails, and a referrer does not
# help. The client is implemented and ready; it activates once funded.
# Get a token at https://enter.pollinations.ai, then either set the token (auto-selects
# Pollinations) or force the provider explicitly.
# POLLINATIONS_TOKEN=your_token_here
# POLLINATIONS_TEXT_MODEL=openai-fast
# POLLINATIONS_MIN_GAP_MS=6000

# Which provider runs judging and writing.
#   auto         (default) Pollinations when POLLINATIONS_TOKEN is set, else Gemini
#   pollinations force Pollinations; fails loudly if unfunded
#   gemini       force Gemini
# TEXT_PROVIDER=auto

# How candidates are found.
#   auto     (default) Google Search grounding when the text provider supports it,
#            otherwise feeds. Also falls back to feeds if grounding quota runs out.
#   feeds    Hacker News + 6 RSS feeds. No LLM call, no quota, URLs real by construction.
#   grounded One Gemini call with Google Search.
# DISCOVERY_MODE=auto

# --------------------------------- Groq ------------------------------------
# DEFAULT text provider (judging and writing). Free key: https://console.groq.com/keys
# Preferred over Gemini because the free tier is measured per minute at high volume
# rather than ~20 requests per model per day, and responses land in ~0.1-0.5s rather
# than 4-12s — a full cycle drops from ~2 minutes to ~15 seconds.
GROQ_API_KEY=your_key_here

# gpt-oss-120b is primary on measured quality: against the same fixed candidate,
# llama-3.3-70b produced a 35-word draft that failed the length lint, while this one
# cleared the voice check first pass. A regeneration costs an extra call, so the better
# model is also the cheaper one.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,qwen/qwen3.6-27b,llama-3.1-8b-instant
# GROQ_MIN_GAP_MS=700
#
# NOTE: Groq has no web-search grounding. `groq/compound` advertises it but rejects even a
# minimal request with `request_too_large` on the free tier, so discovery runs from feeds.
