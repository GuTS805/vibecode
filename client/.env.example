# Vite only exposes env vars prefixed VITE_ to client code, and bakes them into the built
# bundle at build time — these two are not secret. The anon key is meant to be public; it can
# only do what Supabase's own auth rules allow, and this app never queries a Supabase table
# with it (Supabase is authentication only — agent/post data lives in the backend's SQLite
# file, reached through this app's own API, not directly from the browser).
#
# Get both from the same Supabase project's Settings > API page as the backend's
# SUPABASE_SERVICE_ROLE_KEY (see the root .env.example) — same project, different key.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Copy this file to client/.env.local (gitignored) with real values, then `npm run dev:client`
# or `npm run build` picks them up automatically.
